    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9780b563-0ef5-402a-a988-37f048a9a632",
              "name": "message",
              "value": "={{\n(() => {\n  const articles = ($json.articles || []).filter(a => a && a.output);\n  const today = new Date().toISOString().split('T')[0];\n  if (articles.length === 0) {\n    return `📊 **오늘의 금융 브리핑 (${today})**\\n\\n오늘은 시장에 영향을 미칠 주요 소식이 없습니다.\\n(중요도 4 이상의 기사 0건)\\n\\n시스템은 정상 작동 중입니다. ✅`;\n  }\n  const sorted = [...articles].sort((a, b) => (b.output.importance || 0) - (a.output.importance || 0));\n  const header = `📈 **오늘의 금융 브리핑 (${today})**\\n읽을 기사 ${articles.length}건\\n\\n`;\n  const MAX_LEN = 1800;\n  let body = '';\n  let included = 0;\n  for (let i = 0; i < sorted.length; i++) {\n    const a = sorted[i].output;\n    const block = `[${i + 1}] ${a.category || '기타'} | ${a.title || '(제목 없음)'}\\n${a.summary || ''}\\n🔗 ${a.link || ''}\\n\\n`;\n    if (body.length + block.length > MAX_LEN) break;\n    body += block;\n    included++;\n  }\n  if (included < articles.length) {\n    body += `...외 ${articles.length - included}건은 발송 이력 시트에서 확인해주세요.`;\n  }\n  const quoted = body.trim().split('\\n').map(line => `> ${line}`).join('\\n');\n  return `${header}${quoted}`;\n})()\n}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
