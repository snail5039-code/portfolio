# 이 파일을 `.env`(git 제외)로 복사해서 값을 채운다. 실제 키는 커밋하지 않는다.
# 서버에는 증권사 키·계좌번호를 넣지 않는다. 그 값은 사용자 폰에만 저장한다.

# PostgreSQL (docker 컨테이너 invest-db, 이미지 pgvector/pgvector:pg18)
# 테스트는 같은 서버의 invest_test DB를 만들어 쓴다.
# POSTGRES_PASSWORD는 docker 컨테이너를 띄울 때만 쓴다 (서버 코드는 DATABASE_URL만 읽는다)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<비밀번호>@localhost:5432/invest

# 금융감독원 OpenDART 인증키. https://opendart.fss.or.kr
OPENDART_API_KEY=

# 공공데이터포털 금융위원회_주식시세정보 인증키. https://www.data.go.kr/data/15094808/openapi.do
DATA_GO_KR_API_KEY=

# 서버가 매일 분석용 데이터를 자동 수집하는 시각 (KST, 쉼표로 여러 번, 비우면 7,14). off면 끈다
AUTO_COLLECT_HOUR=
# 아침 브리핑 자동 시각 (비우면 08:20, off면 끔)
MORNING_BRIEF_TIME=
# 장 마감 요약 시각 (비우면 15:40, off면 끔)
CLOSE_SUMMARY_TIME=
# 장 마감 AI 회고·내일 계획 시각 (예: 15:50). Gemini 비용이 생겨 비우면 끔
CLOSE_REVIEW_TIME=

# Gemini API 키. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 비우면 gemini-3.6-flash
GEMINI_MODEL=
# 비우면 gemini-embedding-2
GEMINI_EMBEDDING_MODEL=

# 개발용: 장 운영 시간 검사를 이 시각으로 한다 (예: 10:00). 장이 닫힌 시간에 주문 흐름을 확인할 때만. 운영에서는 비운다
MARKET_CLOCK=
# 웹 개발 서버 주소 (예: http://localhost:5000). 쉼표로 여러 개
CORS_ORIGINS=
# 대화 속 성향 신호 모델 (apps/finetune/serve.py, 예: http://127.0.0.1:8100/classify). 비우면 안 씀
SIGNAL_MODEL_URL=
# 분석 때 Google 뉴스 RSS로 종목 뉴스를 받는다. off면 저장된 뉴스만
NEWS_FETCH=
# 폰 푸시 알림용 Firebase 서비스 계정 JSON 경로. 비우면 알림을 쌓기만 한다
FIREBASE_CREDENTIALS=
# 모의투자에도 금액 한도(1회·1일·계좌 비율)를 적용할지 (on이면 적용, 비우면 끔). 실전은 항상 적용
MOCK_ORDER_LIMITS=
