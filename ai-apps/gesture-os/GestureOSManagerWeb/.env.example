# GestureOSManagerWeb 환경변수 예시
#
# 이 파일을 복사해서 값을 채운 뒤, 서버를 띄우는 셸에서 export 하거나
# IDE 실행 구성의 환경변수에 넣는다. (.env 자체는 커밋하지 않는다)
#
#   cp .env.example .env
#
# 없어도 기동되는 값과 없으면 기동되지 않는 값이 구분되어 있다.

# =========================================================
# 필수 — 없으면 서버가 뜨지 않는다
# =========================================================

# JWT 서명키. 32바이트 이상. 절대 커밋하지 말고, 바꾸면 기존 토큰은 모두 무효가 된다.
#   openssl rand -base64 48
JWT_SECRET=

# =========================================================
# 필수 — PostgreSQL (기동 시 schema.sql / data.sql 을 실행한다)
# =========================================================
DB_URL=jdbc:postgresql://localhost:5432/slt
DB_USER=sltuser
DB_PASSWORD=sltpass

# 시드 admin 계정의 초기 비밀번호(8자 이상).
# 비워두면 admin 은 로그인 불가 상태로 남는다. 한 번 설정된 뒤에는 이 값을 바꿔도 덮어쓰지 않는다.
ADMIN_INITIAL_PASSWORD=

# =========================================================
# 선택 — 없으면 해당 기능만 비활성된다
# =========================================================

# 메일(이메일 인증코드, 아이디 찾기, 비밀번호 재설정).
# 없으면 해당 API 가 503 으로 응답한다.
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# AI 도움말(/api/help).
OPENAI_API_KEY=

# 도움말 임베딩 캐시 파일 경로.
# HELP_VECTOR_CACHE_PATH=./data/help-vectors.json

# 소셜 로그인. 값이 없으면 해당 제공자 버튼만 동작하지 않는다.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=

# 소셜 로그인 성공 후 돌아갈 프런트 주소.
# FRONTEND_REDIRECT_URI=http://localhost:5174/oauth2/success

# KCISA 공공데이터 연동. 값이 없으면 연동만 비활성된다.
# (예전 키는 소스에 커밋되어 노출됐으므로, 쓸 거라면 재발급해서 넣는다)
KCISA_SERVICE_KEY=
