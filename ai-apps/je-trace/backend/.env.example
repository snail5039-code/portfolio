# MySQL connection used by Spring Boot
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/jetrace?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=jetrace_app
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# OpenAI API key used by the student chat and similarity analysis services
OPENAI_API_KEY=replace-with-your-openai-api-key

# Local backend port
PORT=8080
SESSION_TIMEOUT=30m
# For cross-site HTTPS deployments, use none and true together.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
# Keep disabled except during a controlled administrator maintenance window.
MAINTENANCE_BACKFILL_ENABLED=false
# One-time administrator bootstrap. Enable only for the first successful startup.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_LOGIN_ID=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=관리자
